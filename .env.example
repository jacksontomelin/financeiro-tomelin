# ===== BANCO DE DADOS =====
# PostgreSQL 16 (recomendado rodar em container/VPS separado)
# Use este `.env` se o Postgres está em outro lugar (remoto)

# Opção 1: Postgres em outro container na mesma máquina (localhost)
# DATABASE_URL=postgresql+psycopg2://tomelin:SENHA@localhost:5432/tomelin

# Opção 2: Postgres em outra VPS/servidor remoto
# DATABASE_URL=postgresql+psycopg2://tomelin:SENHA@postgres.sua-vps.com.br:5432/tomelin

# Configure aqui o endereço do seu Postgres:
DATABASE_URL=postgresql+psycopg2://tomelin:TROQUE_POR_SENHA_FORTE@localhost:5432/tomelin

# Se rodar Postgres localmente com docker-compose.postgres.yml:
#   docker-compose -f docker-compose.postgres.yml up -d
#   DATABASE_URL=postgresql+psycopg2://tomelin:SENHA@localhost:5432/tomelin

# ===== SEGURANÇA =====
SECRET_KEY=GERE_UMA_CHAVE_ALEATORIA_BEM_GRANDE_AQUI_min_32_chars
TOKEN_HORAS=72

# ===== ADMIN (usuário inicial) =====
ADMIN_NOME=Jackson Tomelin
ADMIN_EMAIL=admin@tomelin.com.br
ADMIN_SENHA=MUDE_PARA_SENHA_FORTE

# ===== WHATSAPP (integração estilo Sentinela) =====
# Ativa/desativa o envio de mensagens (alertas, recibos, fechamento)
WHATSAPP_ATIVO=false

# URL do seu gateway WhatsApp (ex.: zap.unicontroller.com.br)
WHATSAPP_API_URL=

# Token de autenticação Bearer para o gateway
WHATSAPP_API_TOKEN=

# ID do grupo ou nome exato do grupo no WhatsApp
# Formato de ID: "120363123456789@g.us"
WHATSAPP_GRUPO=

# Endpoints do gateway (adapte se usar gateway customizado)
WHATSAPP_ENDPOINT_ENVIAR=/api/enviar

# Recibo automático no WhatsApp ao dar baixa
RECIBO_WHATSAPP_AUTO=true

# ===== ALERTAS AUTOMÁTICOS =====
# Hora do alerta diário de vencimentos (0-23, formato 24h)
ALERTA_HORA=8

# Quantos dias antes avisar os vencimentos
ALERTA_DIAS_ANTES=3

# Ativa resumo semanal (segunda-feira)
RESUMO_SEMANAL=true

# Fechamento do dia (resumo de contas pagas/recebidas)
FECHAMENTO_DIARIO=true
FECHAMENTO_HORA=20

# Fuso horário (afeta scheduler de alertas)
TIMEZONE=America/Sao_Paulo

# ===== FIPE (tecnologia própria — consulta de valor de veículos) =====
# Ativa a consulta automática de FIPE via FIPEConsulta
FIPE_ATIVO=false

# URL da sua API FIPEConsulta (ex.: https://fipe.unicontroller.com.br)
FIPE_API_URL=

# Token Bearer para autenticação (se exigido)
FIPE_API_TOKEN=

# Template do endpoint; {codigo} é substituído pelo código do veículo
FIPE_ENDPOINT=/api/fipe/{codigo}

# ===== DADOS PARA RECIBOS/BALANCETES EM PDF =====
# Nome que aparece no cabeçalho/rodapé dos PDFs
EMPRESA_NOME=Tomelin — Gestão Financeira da Família

# CPF/CNPJ opcional (fica no rodapé)
EMPRESA_DOC=

# Cidade/localização (rodapé)
EMPRESA_CIDADE=Blumenau/SC
