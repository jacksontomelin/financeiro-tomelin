# ============================================================
# Tomelin Gestão Financeira — variáveis de ambiente
# Copie para .env (ou preencha no painel do Coolify)
# ============================================================

# --- Banco PostgreSQL ---
POSTGRES_USER=tomelin
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=tomelin
# Se usar um Postgres já existente, defina DATABASE_URL direto:
# DATABASE_URL=postgresql+psycopg2://usuario:senha@host:5432/banco

# --- Segurança / login admin (TROQUE!) ---
SECRET_KEY=gere-uma-chave-aleatoria-bem-grande-aqui
TOKEN_HORAS=72
ADMIN_NOME=Jackson Tomelin
ADMIN_EMAIL=admin@tomelin.com.br
ADMIN_SENHA=tomelin123

# --- WhatsApp (estilo Sentinela) ---
# Aponte para o seu gateway (o mesmo do whatsapp.jackson / zap.unicontroller.com.br)
WHATSAPP_ATIVO=false
WHATSAPP_API_URL=https://zap.unicontroller.com.br
WHATSAPP_API_TOKEN=
WHATSAPP_GRUPO=
RECIBO_WHATSAPP_AUTO=true
WHATSAPP_ENDPOINT_ENVIAR=/api/enviar

# --- Alertas automáticos ---
ALERTA_HORA=8
ALERTA_DIAS_ANTES=3
RESUMO_SEMANAL=true
FECHAMENTO_DIARIO=true
FECHAMENTO_HORA=20
TIMEZONE=America/Sao_Paulo

# ---- FIPEConsulta (valor automático dos veículos) ----
FIPE_ATIVO=false
FIPE_API_URL=
FIPE_API_TOKEN=
FIPE_ENDPOINT=/api/fipe/{codigo}

# ---- Dados para recibos e balancetes em PDF ----
EMPRESA_NOME=Tomelin — Gestão Financeira da Família
EMPRESA_DOC=
EMPRESA_CIDADE=Blumenau/SC
